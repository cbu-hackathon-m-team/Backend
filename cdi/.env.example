# Copy to .env and choose a local development password; never commit real credentials.
POSTGRES_PASSWORD=replace-with-a-local-password
# Export DATABASE_URL into your shell; .env is not auto-loaded by the Python backend.
DATABASE_URL=postgresql+asyncpg://ossguard:replace-with-a-local-password@127.0.0.1:15432/ossguard
# No AI key is needed for this execution-backend scope.
