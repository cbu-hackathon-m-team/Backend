# Copy to .env and choose a long random team token. Swagger Authorize: Bearer token.
OSSGUARD_DATABASE_URL=postgresql+asyncpg://ossguard:ossguard@127.0.0.1:54329/ossguard
OSSGUARD_API_TOKEN=replace-with-a-long-random-team-token
OSSGUARD_ALLOWED_REPOS=[]
OSSGUARD_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
OSSGUARD_RUNNER_ID=runner-1
OSSGUARD_WORK_DIR=.work
# Optional; only platform API uses this token, never cloned target applications.
OSSGUARD_GITHUB_TOKEN=
# Explicit model selection; without AI credentials, use manual tests and factual results.
OSSGUARD_AI_KEY=
OSSGUARD_AI_MODEL=
OSSGUARD_EMAIL_KEY=
OSSGUARD_EMAIL_FROM=
OSSGUARD_RESULT_BASE_URL=http://localhost:3000/validations
# Dedicated GCP project containing target app secrets, NOT platform AI/mail credentials.
OSSGUARD_SECRET_PROJECT_ID=
